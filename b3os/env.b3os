# GPT Researcher on B3OS: the integration map as a dotenv file. No secrets: every value here is safe to commit.
#
# b3os.yaml's services[0].env carries the same values; this file is the commented copy, and the one to load for a
# run outside B3OS against beta-api.b3os.org (see the last section). Named env.b3os, not .env.b3os: B3OS refuses to
# deploy a service root that tracks a file whose name starts with ".env" (README-B3OS.md, "Why some files moved").
#
# Inside a B3OS sandbox every B3OS call goes to http://127.0.0.1:7700 and no key is checked: the sandbox's grant,
# derived from `uses` in b3os.yaml, decides what it may call. "in-sandbox" below is a placeholder the clients need
# because they refuse an empty key.

# --- Model: the node's chat model for all three roles (OpenAI wire format at /v1/infer) --------------------------
OPENAI_BASE_URL=http://127.0.0.1:7700/v1/infer
OPENAI_API_KEY=in-sandbox
FAST_LLM=openai:b3os/default
SMART_LLM=openai:b3os/default
STRATEGIC_LLM=openai:b3os/default

# --- Token limits: fit b3os/default (alias of b3os/qwen3.5-9b, 32,768-token context, 4,096 default max tokens) ---
# Upstream defaults (6000 / 12000 / 8000 output tokens, 8192-character chunks, 1200 words) assume a frontier model
# with a long context; the writer prompt carries all gathered context, so these are cut to leave room for it.
FAST_TOKEN_LIMIT=2000
SMART_TOKEN_LIMIT=4096
STRATEGIC_TOKEN_LIMIT=2000
SUMMARY_TOKEN_LIMIT=700
BROWSE_CHUNK_MAX_LENGTH=4000
TOTAL_WORDS=900
# Reasoning is off by default on the node (reasoning_effort unset), and GPT Researcher sends reasoning_effort only
# for OpenAI o-series names, so no thinking text reaches the JSON answers. To try reasoning on the planner:
# LLM_KWARGS={"reasoning_effort": "low"}

# --- Context filter: keyword (BM25, local). B3OS serves no embedding model (POST /v1/infer/embeddings -> 404). ---
# The fork also makes the detailed report's written-section matching honor this (gpt_researcher/skills/context_manager.py).
CONTEXT_FILTER=keyword

# --- Search: the crw retriever speaks Firecrawl's POST /v1/search, which B3OS serves at /compat/firecrawl ------------
RETRIEVER=crw
CRW_API_URL=http://127.0.0.1:7700/compat/firecrawl
CRW_API_KEY=in-sandbox
MAX_SEARCH_RESULTS_PER_QUERY=5

# --- Scrape: firecrawl-py's scrape() -> POST /compat/firecrawl/v2/scrape, served by B3OS vision ------------------
SCRAPER=firecrawl
# No DNS for the internet in the sandbox (vision fetches the pages): let unresolved hosts past the SSRF check.
ALLOW_UNRESOLVED_URLS=true
FIRECRAWL_SERVER_URL=http://127.0.0.1:7700/compat/firecrawl
FIRECRAWL_API_KEY=in-sandbox
# Workers: upstream runs 15 scrapers at once and deep research 4 branches; lowered so one report stays inside the
# organization's scrape rate and the node's browser pool.
FIRECRAWL_CONCURRENCY=4
MAX_SCRAPER_WORKERS=4
DEEP_RESEARCH_CONCURRENCY=2
# Deep Research's final context in words: upstream 25,000 (about 33k tokens) overflows the 32,768-token model
DEEP_RESEARCH_MAX_CONTEXT_WORDS=15000
# print() output is block-buffered without a terminal; unbuffered, each line reaches the log when printed
PYTHONUNBUFFERED=1

# --- tiktoken: cost estimates read o200k_base from this cache, filled at build time (egress cannot fetch it) ------
TIKTOKEN_CACHE_DIR=/workspace/app/.tiktoken

# --- Publish hook (backend/server/b3os_publish.py) -------------------------------------------------------------
B3OS_PUBLISH_ROUTINE=publish-report
SLACK_CHANNEL=C0000000000            # placeholder: the Slack channel id
# B3OS_API_URL is set by B3OS in every sandbox (http://127.0.0.1:7700); the hook does nothing without it.

# --- Secrets: names only. None is needed for the node-only setup above. ----------------------------------------
# Optional frontier planner, off the node (B3OS has no gateway route on the beta). In b3os.yaml, as a secret from a
# vault connection, never as a value here:
#   secrets: { ANTHROPIC_API_KEY: { connection: anthropic-key, field: token } }
# STRATEGIC_LLM=anthropic:<model>
# ANTHROPIC_API_KEY=<from vault connection anthropic-key>
# The Slack bot token lives only in the vault connection labelled slack-bot; the service never sees it.

# --- Outside B3OS (a laptop against beta-api.b3os.org) ---------------------------------------------------------
# Replace every http://127.0.0.1:7700 with https://beta-api.b3os.org and every "in-sandbox" with a project key
# (B3OS_API_KEY), and unset B3OS_PUBLISH_ROUTINE unless B3OS_API_URL is set too.
